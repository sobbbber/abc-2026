#Определение типа сортировки
def sort():
    while True:
        try:
            u = int(input("Введи интересующий тип сортировки: \n1. По возрасту\n2. По первой букве\n3. По группе\n"))
            if u > 0 and u <= 3:
                break
            else:
                print("Ошибка, значение только целое от 1 до 3!!!!")
        except ValueError:
            print("Ошибка, значение только типа int!!!!")
    return u

