import  random
import json

_dict = {'False': 'Логическое значение', 'None': 'Пустой'}
keys = list(_dict.keys())
ind = random.randint(0, len(keys) - 1)
secret = keys[ind]
mask = [' * '] * len(secret)


def save_game(_dict, secret, mask):
    file = {"dict": _dict, "secret": secret, "mask": mask}
    with open("file.json", "w", encoding="utf-8") as f:
        json.dump(file, f, ensure_ascii=False, indent=4)

def load_game():
    with open("file.json", "rt", encoding="utf-8") as f:
        file = json.load(f)
    _dict=file["dict"]
    secret=file["secret"]
    mask=file["mask"]
    return _dict, secret, mask
