class Product:
    def __init__(self, name:str, price:int):
        self.name = name
        self.price = price
    
    @property
    def name(self):
        return self._name
    
    @name.setter
    def name(self, value:str):
        self._name = value

    @property
    def price(self):
        return self._price
    
    @price.setter
    def price(self, value:int):
        if value >= 0:
            self._price = int(value)
        else:
            self._price = 0
    
product = Product("Book", 10)
print(product.price)  # 10
product.price = -5
print(product.price)  # 0
